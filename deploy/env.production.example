# Copy to /var/www/client_apps/qronex/.env on the server, fill the empty values, then: php artisan key:generate && php artisan config:cache
APP_NAME=QRONEX
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://qronex.app
APP_TIMEZONE=UTC

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qronex
DB_USERNAME=qronex
# strong password
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=log   # switch to smtp once MAIL_* is filled
# smtp host
MAIL_HOST=
MAIL_PORT=587
# user
MAIL_USERNAME=
# password
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=no-reply@qronex.app
MAIL_FROM_NAME=QRONEX

# rzp_live_…
RAZORPAY_KEY_ID=
# secret
RAZORPAY_KEY_SECRET=
# webhook secret set in Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=

SMS_DRIVER=log    # switch to http once the DLT gateway is set
# DLT gateway send URL
SMS_URL=
# key
SMS_API_KEY=
SMS_SENDER=QRONEX
# DLT principal entity id
SMS_DLT_PE_ID=

QRONEX_SUPPLIER_NAME="Ametecs India Private Limited"
# 36…
QRONEX_SUPPLIER_GSTIN=
QRONEX_SUPPLIER_STATE=Telangana
# registered address
QRONEX_SUPPLIER_ADDRESS=
QRONEX_SUPPORT_EMAIL=support@qronex.app
QRONEX_GRACE_DAYS=7
QRONEX_REQUIRE_ADMIN_2FA=true
# Used once by ProductionSeeder:
QRONEX_ADMIN_EMAIL=ejaz@ametecsindia.com
