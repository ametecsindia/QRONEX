# Copy to /var/www/client_apps/qronex/.env on the server, fill every <…>, then: php artisan key:generate && php artisan config:cache
APP_NAME=QRONEX
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://qronex.app
APP_TIMEZONE=UTC

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qronex
DB_USERNAME=qronex
DB_PASSWORD=<strong password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=<smtp host>
MAIL_PORT=587
MAIL_USERNAME=<user>
MAIL_PASSWORD=<password>
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=no-reply@qronex.app
MAIL_FROM_NAME=QRONEX

RAZORPAY_KEY_ID=<rzp_live_…>
RAZORPAY_KEY_SECRET=<secret>
RAZORPAY_WEBHOOK_SECRET=<webhook secret set in Razorpay dashboard>

SMS_DRIVER=http
SMS_URL=<DLT gateway send URL>
SMS_API_KEY=<key>
SMS_SENDER=QRONEX
SMS_DLT_PE_ID=<DLT principal entity id>

QRONEX_SUPPLIER_NAME="Ametecs India Private Limited"
QRONEX_SUPPLIER_GSTIN=<36…>
QRONEX_SUPPLIER_STATE=Telangana
QRONEX_SUPPLIER_ADDRESS="<registered address>"
QRONEX_SUPPORT_EMAIL=support@qronex.app
QRONEX_GRACE_DAYS=7
QRONEX_REQUIRE_ADMIN_2FA=true
# Used once by ProductionSeeder:
QRONEX_ADMIN_EMAIL=ejaz@ametecsindia.com
